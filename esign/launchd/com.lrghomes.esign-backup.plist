<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly 2:40 AM offsite backup of the e-sign database + signed documents to
  Drive "Business Operations/E-Sign Backups" (esign/scripts/backup.mjs).
  Telegram alert on failure only.
  Install:  cp esign/launchd/com.lrghomes.esign-backup.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.lrghomes.esign-backup.plist
  Run now:  launchctl start com.lrghomes.esign-backup
  Logs:     ~/Projects/logs/esign-backup.log
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.lrghomes.esign-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>scripts/backup.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/ryanlarocca/Projects/PROJECTS/mission-control/esign</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>40</integer></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/ryanlarocca/Projects/logs/esign-backup.log</string>
  <key>StandardErrorPath</key><string>/Users/ryanlarocca/Projects/logs/esign-backup.log</string>
</dict>
</plist>
