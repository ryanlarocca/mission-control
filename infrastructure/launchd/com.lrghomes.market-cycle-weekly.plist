<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Market-cycle weekly chain, Mondays 06:00 PT:
    1. collect-weekly.py --write --alert-on-failure   MLSListings counts,
       snapshots, panels, owned zips, NODs (readings dated to the Monday)
    2. tripwires.py --live --write --post

  Install / reload (Mac mini):
    cp infrastructure/launchd/com.lrghomes.market-cycle-weekly.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.lrghomes.market-cycle-weekly 2>/dev/null; launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.lrghomes.market-cycle-weekly.plist
  Run once:  launchctl kickstart gui/$(id -u)/com.lrghomes.market-cycle-weekly
  Log:       ~/Library/Logs/lrg-market-cycle-weekly.log (stdout + stderr; /tmp is emptied nightly)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lrghomes.market-cycle-weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>scripts/market-cycle/run.sh</string>
    <string>weekly</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ryanlarocca/Projects/PROJECTS/mission-control</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/ryanlarocca</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ryanlarocca/Library/Logs/lrg-market-cycle-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ryanlarocca/Library/Logs/lrg-market-cycle-weekly.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
