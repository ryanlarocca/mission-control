<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Market-cycle daily chain (brief v2, Nov 7, 2026), 06:30 PT:
    1. collect-macro.py --write   every history dial (FRED, Zillow, Realtor.com
       via FRED, EDD WARN, Apartment List, Indeed, Nasdaq basket, C.A.R. +
       SCCAOR); new readings + recent revisions; one Telegram alert on failure
    2. tripwires.py --live --write --post   every big tripwire, daily
    3. review.ts --check --write --send     the review, only when due
       (data-ready cadence, lib/marketCycle/schedule.ts) or a tripwire is pending
  Replaces the separate 07:30 com.lrghomes.market-cycle-review job (removed:
  it could run before the collector finished).
  PATH includes /opt/homebrew/bin for pdftotext and npx (LaunchAgents run with
  a bare environment).

  Install / reload (Mac mini):
    cp infrastructure/launchd/com.lrghomes.market-cycle-macro.plist ~/Library/LaunchAgents/
    launchctl bootout gui/$(id -u)/com.lrghomes.market-cycle-macro 2>/dev/null; launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.lrghomes.market-cycle-macro.plist
  Run once:  launchctl kickstart gui/$(id -u)/com.lrghomes.market-cycle-macro
  Log:       ~/Library/Logs/lrg-market-cycle-daily.log (stdout + stderr; /tmp is emptied nightly)
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lrghomes.market-cycle-macro</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>scripts/market-cycle/run.sh</string>
    <string>daily</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ryanlarocca/Projects/PROJECTS/mission-control</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/ryanlarocca</string>
    <key>PYTHONUNBUFFERED</key>
    <string>1</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ryanlarocca/Library/Logs/lrg-market-cycle-daily.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ryanlarocca/Library/Logs/lrg-market-cycle-daily.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
