<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Market-cycle macro collector (2026-11-02): daily 06:30 PT pull of every
  history dial (FRED, Zillow, Realtor.com via FRED, EDD WARN, Apartment List,
  Indeed, Nasdaq basket, C.A.R. + SCCAOR monthly releases). Writes only
  readings newer than what is stored, plus silent scheduled-release notes
  (cycle_notes). A failed source posts one Telegram alert.
  Spec: briefs/BRIEF_MARKET_CYCLE_TRACKER_2026-11-01.md (3.3).

  Prerequisites: both market-cycle migrations applied
  (2026-11-01_market_cycle.sql, 2026-11-02_market_cycle_macro.sql), then
  python3 scripts/market-cycle/sync-registry.py --write and
  python3 scripts/market-cycle/bootstrap-history.py --write.

  PATH includes /opt/homebrew/bin so pdftotext (EDD + SCCAOR PDFs) is found
  (DEPLOYMENT.md gotcha #2: LaunchAgents run with a bare environment).

  Install (Mac mini) — NOT installed yet:
    cp infrastructure/launchd/com.lrghomes.market-cycle-macro.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.lrghomes.market-cycle-macro.plist
  Run once:  launchctl start com.lrghomes.market-cycle-macro
  Logs:      /tmp/lrg-market-cycle-macro.log, /tmp/lrg-market-cycle-macro-err.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.lrghomes.market-cycle-macro</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>scripts/market-cycle/collect-macro.py</string>
    <string>--write</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ryanlarocca/Projects/PROJECTS/mission-control</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/ryanlarocca</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/lrg-market-cycle-macro.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/lrg-market-cycle-macro-err.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
